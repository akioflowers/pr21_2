<Window x:Class="pr_21_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Магазин комплектующих" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель добавления и управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Label Content="Название:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtName" Width="120" Margin="5"/>

            <Label Content="Цена:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtPrice" Width="60" Margin="5"/>

            <Label Content="Кол-во:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtCount" Width="50" Margin="5"/>

            <Button Content="Добавить товар" Click="Add_Click" Width="110" Margin="10,0,0,0"/>
            <Button Content="Удалить товар" Click="Del_Click" Width="110" Margin="10,0,0,0"/>
        </StackPanel>

        <DataGrid x:Name="tableProduct" Grid.Row="1" AutoGenerateColumns="False" 
                  Margin="10" SelectionChanged="tableProduct_SelectionChanged"
                  CanUserAddRows="False" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
                <DataGridTextColumn Header="Количество на складе" Binding="{Binding Count}" Width="150"/>

                <DataGridTemplateColumn Header="Действие" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Купить" Click="Buy1_Click" Margin="2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>